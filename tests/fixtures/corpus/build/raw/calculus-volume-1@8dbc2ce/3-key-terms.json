{
 "slug": "3-key-terms",
 "title": "Key Terms",
 "content": "<html xmlns=\"http://www.w3.org/1999/xhtml\"><body><div class=\"os-eoc os-glossary-container\" data-type=\"composite-page\" data-uuid-key=\"glossary\" id=\"composite-page-9\" data-book-content=\"true\"><h3 data-type=\"title\">\n    <span class=\"os-text\">Key Terms</span>\n  </h3>\n  <div class=\"os-glossary-list\"><div class=\"os-glossary-list-item\"><dl id=\"fs-id1169739252840\">\n<dt>acceleration</dt>\n<dd id=\"fs-id1169739252845\">is the rate of change of the velocity, that is, the derivative of velocity</dd>\n</dl></div>\n<div class=\"os-glossary-list-item\"><dl id=\"fs-id1169739252849\">\n<dt>amount of change</dt>\n<dd id=\"fs-id1169739252854\">the amount of a function <math display=\"inline\"><semantics><mrow><mrow><mi>f</mi><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></mrow></semantics></math> over an interval <math display=\"inline\"><semantics><mrow><mrow><mrow><mo>[</mo><mrow><mi>x</mi><mo>,</mo><mi>x</mi><mo>+</mo><mi>h</mi></mrow><mo>]</mo></mrow></mrow></mrow></semantics></math> is <math display=\"inline\"><semantics><mrow><mrow><mi>f</mi><mrow><mo>(</mo><mrow><mi>x</mi><mo>+</mo><mi>h</mi></mrow><mo>)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></mrow></semantics></math></dd>\n</dl></div>\n<div class=\"os-glossary-list-item\"><dl id=\"fs-id1169739190003\">\n<dt>average rate of change</dt>\n<dd id=\"fs-id1169739190009\">is a function <math display=\"inline\"><semantics><mrow><mrow><mi>f</mi><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></mrow></semantics></math> over an interval <math display=\"inline\"><semantics><mrow><mrow><mrow><mo>[</mo><mrow><mi>x</mi><mo>,</mo><mi>x</mi><mo>+</mo><mi>h</mi></mrow><mo>]</mo></mrow></mrow></mrow></semantics></math> is <math display=\"inline\"><semantics><mrow><mrow><mfrac><mrow><mi>f</mi><mrow><mo>(</mo><mrow><mi>a</mi><mo>+</mo><mi>h</mi></mrow><mo>)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo>(</mo><mi>a</mi><mo>)</mo></mrow></mrow><mrow><mi>h</mi></mrow></mfrac></mrow></mrow></semantics></math></dd>\n</dl></div>\n</div>\n</div></body></html>"
}