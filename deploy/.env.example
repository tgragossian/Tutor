# Copy to deploy/.env (never committed) and fill in.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATHTUTOR_SECRET_KEY=
# e.g. localhost locally, your domain on the server
SITE_ADDRESS=
# Verifier pool (optional; defaults 1 worker, 384 MB cap each). Size from docs/ops/host.md:
# workers x cap + app + Caddy + OS must stay within 85% of RAM.
# MATHTUTOR_POOL_SIZE=1
# MATHTUTOR_POOL_MEMORY_MB=384
